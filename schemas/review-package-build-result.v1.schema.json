{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review Package Build Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logical_round_id",
    "build_status",
    "failure_stage",
    "artifact_protocol_verification",
    "semantic_review_status",
    "review_decision_status",
    "authorization_granted",
    "acceptance_signal_emitted",
    "automatic_next_authorized",
    "artifact_set_committed",
    "error_code",
    "architecture_signal_issued",
    "implementation_accepted",
    "package_zip",
    "detached_sha256",
    "ready_marker",
    "immutable_build_record",
    "windows_sidecar",
    "linux_sidecar",
    "platform_matrix",
    "publication_filesystem_preflight",
    "stage_timings",
    "objective_delivery_metrics",
    "diagnostics_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "logical_round_id": {
      "type": "string",
      "minLength": 1
    },
    "build_status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "failure_stage": {
      "enum": [
        "PREFLIGHT",
        "SOURCE_EXPORT",
        "EVIDENCE_BUILD",
        "BUNDLE_BUILD",
        "VERIFICATION",
        "PUBLICATION",
        "CLEANUP",
        "CANDIDATE_BYTES_FROZEN",
        "FINAL_CANDIDATE_VERIFIED",
        "WINDOWS_SIDECAR_VERIFIED",
        "LINUX_SIDECAR_VERIFIED",
        "PLATFORM_MATRIX_VERIFIED",
        "BUILD_RECORD_GENERATED",
        "DETACHED_SHA_GENERATED",
        "CANDIDATE_ZIP_PUBLISHED",
        "WINDOWS_SIDECAR_PUBLISHED",
        "LINUX_SIDECAR_PUBLISHED",
        "PLATFORM_MATRIX_PUBLISHED",
        "BUILD_RECORD_PUBLISHED",
        "DETACHED_SHA_PUBLISHED",
        "ARTIFACT_SET_VERIFIED",
        null
      ]
    },
    "error_code": {
      "enum": [
        "PREFLIGHT_FAILED",
        "SOURCE_EXPORT_FAILED",
        "EVIDENCE_BUILD_FAILED",
        "BUNDLE_BUILD_FAILED",
        "FINAL_CANDIDATE_VERIFICATION_FAILED",
        "ARTIFACT_SET_VERIFICATION_FAILED",
        "PUBLICATION_FAILED",
        "CLEANUP_FAILED",
        "INJECTED_PUBLICATION_STAGE_FAILURE",
        null
      ]
    },
    "artifact_protocol_verification": {
      "enum": [
        "PASSED",
        "FAILED",
        "NOT_EVALUATED"
      ]
    },
    "semantic_review_status": {
      "const": "NOT_EVALUATED"
    },
    "review_decision_status": {
      "const": "PENDING_INDEPENDENT_REVIEW"
    },
    "authorization_granted": {
      "const": false
    },
    "acceptance_signal_emitted": {
      "const": false
    },
    "architecture_signal_issued": {
      "const": false
    },
    "implementation_accepted": {
      "const": false
    },
    "automatic_next_authorized": {
      "const": false
    },
    "artifact_set_committed": {
      "type": "boolean"
    },
    "package_zip": {
      "type": "string",
      "minLength": 1
    },
    "detached_sha256": {
      "type": "string",
      "minLength": 1
    },
    "ready_marker": {
      "type": "string",
      "minLength": 1
    },
    "immutable_build_record": {
      "type": "string",
      "minLength": 1
    },
    "windows_sidecar": {"type": "string", "minLength": 1},
    "linux_sidecar": {"type": "string", "minLength": 1},
    "platform_matrix": {"type": "string", "minLength": 1},
    "publication_filesystem_preflight": {
      "$ref": "#/$defs/publicationFilesystemPreflight"
    },
    "package_zip_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "review_profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "error_message": {
      "type": "string"
    },
    "diagnostics_dir": {
      "type": "string",
      "minLength": 1
    },
    "diagnostics_capture_status": {
      "enum": ["NOT_REQUIRED", "CAPTURED", "FAILED"]
    },
    "diagnostics_capture_error": {
      "type": "string",
      "minLength": 1
    },
    "stage_timings": {
      "$ref": "#/$defs/stageTimings"
    },
    "objective_delivery_metrics": {
      "$ref": "#/$defs/objectiveDeliveryMetrics"
    },
    "diagnostics_policy": {
      "$ref": "#/$defs/diagnosticsPolicy"
    },
    "path_budget": {
      "$ref": "#/$defs/pathBudget"
    },
    "promotion_gate": {
      "$ref": "#/$defs/promotionGate"
    },
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_inventory_protocol_version": {"const": 1},
    "inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_baseline_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packaged_source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_projection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_inventory_count": {"type": "integer", "minimum": 0},
    "source_baseline_count": {"type": "integer", "minimum": 0},
    "packaged_source_count": {"type": "integer", "minimum": 0},
    "source_manifest_count": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {
        "properties": {"build_status": {"const": "SUCCEEDED"}},
        "required": ["build_status"]
      },
      "then": {
        "required": [
          "candidate_sha256",
          "source_commit",
          "source_tree",
          "source_inventory_protocol_version",
          "inventory_digest",
          "source_baseline_digest",
          "packaged_source_digest",
          "source_manifest_projection_digest",
          "source_inventory_count",
          "source_baseline_count",
          "packaged_source_count",
          "source_manifest_count"
        ]
      }
    }
  ],
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "measurement_source"],
      "properties": {
        "value": {
          "type": ["number", "integer", "null"]
        },
        "measurement_source": {
          "enum": ["TOOL_MEASURED", "NOT_AVAILABLE"]
        }
      }
    },
    "objectiveDeliveryMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manual_package_build_command_count",
        "package_regeneration_count",
        "avoidable_validation_rerun_count",
        "staging_residue_count",
        "operator_touch_minutes",
        "manual_metadata_entry_count"
      ],
      "properties": {
        "manual_package_build_command_count": {"$ref": "#/$defs/measurement"},
        "package_regeneration_count": {"$ref": "#/$defs/measurement"},
        "avoidable_validation_rerun_count": {"$ref": "#/$defs/measurement"},
        "staging_residue_count": {"$ref": "#/$defs/measurement"},
        "operator_touch_minutes": {"$ref": "#/$defs/measurement"},
        "manual_metadata_entry_count": {"$ref": "#/$defs/measurement"}
      }
    },
    "diagnosticsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_diagnostics_bytes",
        "max_retained_failures",
        "retention_days",
        "source_archive_retention",
        "child_log_max_bytes"
      ],
      "properties": {
        "max_diagnostics_bytes": {"type": "integer", "minimum": 1},
        "max_retained_failures": {"type": "integer", "minimum": 1},
        "retention_days": {"type": "integer", "minimum": 0},
        "source_archive_retention": {"type": "boolean"},
        "child_log_max_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "publicationFilesystemPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "long_path_cleanup_smoke",
        "long_path_leaf_utf16_units"
      ],
      "properties": {
        "status": {
          "enum": ["NOT_RUN", "PASSED"]
        },
        "long_path_cleanup_smoke": {
          "enum": ["NOT_RUN", "PASSED"]
        },
        "long_path_leaf_utf16_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stageTimings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_elapsed_seconds",
        "source_export_elapsed_seconds",
        "evidence_elapsed_seconds",
        "evidence_materialization_elapsed_seconds",
        "manifest_generation_elapsed_seconds",
        "bundle_elapsed_seconds",
        "promotion_elapsed_seconds",
        "verification_elapsed_seconds",
        "publication_elapsed_seconds",
        "cleanup_elapsed_seconds",
        "total_elapsed_seconds"
      ],
      "properties": {
        "validation_elapsed_seconds": {"type": "number", "minimum": 0},
        "source_export_elapsed_seconds": {"type": "number", "minimum": 0},
        "evidence_elapsed_seconds": {"type": "number", "minimum": 0},
        "evidence_materialization_elapsed_seconds": {"type": "number", "minimum": 0},
        "manifest_generation_elapsed_seconds": {"type": "number", "minimum": 0},
        "bundle_elapsed_seconds": {"type": "number", "minimum": 0},
        "promotion_elapsed_seconds": {"type": "number", "minimum": 0},
        "verification_elapsed_seconds": {"type": "number", "minimum": 0},
        "publication_elapsed_seconds": {"type": "number", "minimum": 0},
        "cleanup_elapsed_seconds": {"type": "number", "minimum": 0},
        "total_elapsed_seconds": {"type": "number", "minimum": 0}
      }
    },
    "pathBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_zip_utf16_units", "final_ready_utf16_units", "physical_artifact_name"],
      "properties": {
        "final_zip_utf16_units": {"type": "integer", "minimum": 1},
        "final_ready_utf16_units": {"type": "integer", "minimum": 1},
        "physical_artifact_name": {"type": "string", "minLength": 1}
      }
    },
    "promotionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manual_reference_package_verified",
        "builder_shadow_package_verified",
        "independent_comparison_passed",
        "reference_and_shadow_are_distinct_artifacts",
        "bundle_entry_digest_match",
        "comparator_commit",
        "comparator_blob_id"
      ],
      "properties": {
        "manual_reference_package_verified": {"type": "boolean"},
        "builder_shadow_package_verified": {"type": "boolean"},
        "independent_comparison_passed": {"type": "boolean"},
        "reference_and_shadow_are_distinct_artifacts": {"type": "boolean"},
        "bundle_entry_digest_match": {"type": "boolean"},
        "comparator_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "comparator_blob_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
